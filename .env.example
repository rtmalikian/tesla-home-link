# Tesla Home Link — copy to .env and run `thlink setup` (the wizard writes this file for you).
# .env is git-ignored: secrets never leave this computer.

# --- Tesla (read-only: the app never sends commands to the car) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback
THL_VEHICLES=Model Y=YOUR_VIN_HERE

# --- Home identity ---
THL_HOME_NAME=Home
THL_HOME_ADDRESS=
THL_HOME_LAT=
THL_HOME_LON=
THL_ARRIVAL_RADIUS_M=150
THL_APPROACH_GEOFENCE_M=12000

# --- Thermostat: nest | ecobee | homeassistant | webhook | none ---
THL_THERMOSTAT_BACKEND=none
THL_TARGET_TEMP_F=71
THL_AWAY_SETBACK_F=60
THL_HVAC_ETA_MIN=20
# Nest (Smart Device Management API)
THL_NEST_PROJECT_ID=
THL_NEST_CLIENT_ID=
THL_NEST_CLIENT_SECRET=
THL_NEST_REFRESH_TOKEN=
THL_NEST_DEVICE_ID=
# Ecobee
THL_ECOBEE_API_KEY=
THL_ECOBEE_REFRESH_TOKEN=
THL_ECOBEE_THERMOSTAT_ID=
# Home Assistant
THL_HA_URL=
THL_HA_TOKEN=
THL_HA_CLIMATE_ENTITY=climate.home
# Generic webhook (POST {"target_f": <temp>})
THL_THERMOSTAT_WEBHOOK=

# --- Lights: hue | webhook | none ---
THL_LIGHTS_BACKEND=none
THL_LIGHTS_ETA_MIN=5
THL_LIGHTS_AUTO_OFF_MIN=15
THL_HUE_BRIDGE_IP=
THL_HUE_API_KEY=
THL_HUE_SCENE=
THL_LIGHTS_WEBHOOK=

# --- Welcome-home entertainment ---
THL_TV_BACKEND=none            # samsung | lg | none
THL_TV_IP=
THL_TV_MAC=
THL_TV_INPUT=
THL_TV_APP=
THL_CONSOLE_WOL=0
THL_CONSOLE_MACS=
THL_CONSOLE_PLUG=0
THL_PLUG_WEBHOOK=

# --- Leave-home ---
THL_ALARM_WEBHOOK=

# --- Chat server ---
THL_SERVER_HOST=127.0.0.1
THL_SERVER_PORT=8644
THL_SERVER_API_KEY=
THL_MODEL_ID=tesla-home-link

# --- AI backend (pluggable; the rules engine works with it off) ---
THL_AI_BASE_URL=http://localhost:11434/v1
THL_AI_API_KEY=
THL_AI_MODEL=llama3.1
THL_AI_MODE=auto
THL_AI_TIMEOUT_SECONDS=20

# --- Runtime ---
THL_POLL_SECONDS=120
THL_TOKEN_FILE=~/.thlink/tokens.json
THL_STATE_FILE=~/.thlink/state.json
THL_DRY_RUN=0
